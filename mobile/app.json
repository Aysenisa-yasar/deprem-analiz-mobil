{
  "expo": {
    "name": "DepremAnaliz",
    "slug": "depremanaliz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "M5 ve uzeri yakin depremlerde acil kisinize konum gondermek icin kullanilir.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Uygulama acikken deprem yakinligi tespiti icin konum kullanilir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "package": "com.aysenisa.depremanaliz"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Deprem uyarilari icin konum kullanilir (M5+, 150 km)."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://deprem-analiz-mobil.onrender.com",
      "router": {},
      "eas": {
        "projectId": "535817ae-9f67-4aa9-b299-2bafee59057d"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
